    "stack.emptyState": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied and added items\nline up here to paste in turn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que copies o añadas\nse pone en fila para pegarlo"
          }
        }
      }
    },
    "stack.firstUseHint": {
      "comment": "Shown above the rows the first time a Paste Stack opens.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each copy joins the list; ⌘V pastes them one by one, in order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada copia se suma a la lista; ⌘V las pega una a una, en orden."
          }
        }
      }
    },
