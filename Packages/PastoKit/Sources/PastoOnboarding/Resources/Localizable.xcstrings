{
  "sourceLanguage": "en",
  "strings": {
    "about.acknowledgements": {
      "comment": "About window button that opens the third-party licenses, and that window's title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acknowledgements"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agradecimientos"
          }
        }
      }
    },
    "about.copyright": {
      "comment": "About window: the copyright line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Jaime Navas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Jaime Navas"
          }
        }
      }
    },
    "about.disclaimer": {
      "comment": "About window, under the copyright line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free software, provided as is, without warranty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Software gratuito, ofrecido tal cual, sin garantía."
          }
        }
      }
    },
    "about.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión %@"
          }
        }
      }
    },
    "about.windowTitle": {
      "comment": "Title of the About window; hidden, read by VoiceOver and Mission Control.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Pasto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de Pasto"
          }
        }
      }
    },
    "acknowledgements.introduction": {
      "comment": "Acknowledgements window: the line above the licenses.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto includes the following third-party software, distributed under these licenses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto incluye el siguiente software de terceros, distribuido con estas licencias."
          }
        }
      }
    },
    "welcome.help.pageTitle": {
      "comment": "Welcome content: what the help link's preview says about the contact page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question or report a problem"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta o informa de un problema"
          }
        }
      }
    },
    "welcome.help.title": {
      "comment": "Welcome content: name of the link to the contact page, on the welcome pinboard.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need a Hand?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Necesitas ayuda?"
          }
        }
      }
    },
    "welcome.note.text": {
      "comment": "Welcome content: text of the note that opens the welcome pinboard.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The links on this pinboard lead to Pasto’s website, to help when you need it and to what’s new in each version.\n\nOpen one with ⌘O, or with Open in its right-click menu. The pinboard is yours: rename it, add to it or delete it whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de este pinboard llevan a la web de Pasto, a la ayuda por si la necesitas y a las novedades de cada versión.\n\nAbre uno con ⌘O o con Abrir en su menú de clic derecho. El pinboard es tuyo: cámbiale el nombre, añádele lo que quieras o elimínalo cuando te parezca."
          }
        }
      }
    },
    "welcome.note.title": {
      "comment": "Welcome content: name of the note that opens the welcome pinboard.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Pasto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida"
          }
        }
      }
    },
    "welcome.paste.text": {
      "comment": "Welcome content: text of the history note on pasting. %@ is the activation shortcut, such as ⇧⌘V.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you copy is kept here, newest first.\n\nPress %@ in any app to open Pasto, choose an item with the arrow keys and press Return to paste it. Press Space for a closer look first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que copias se guarda aquí, lo más reciente primero.\n\nPulsa %@ en cualquier app para abrir Pasto, elige un ítem con las flechas y pulsa Retorno para pegarlo. Pulsa Espacio para verlo de cerca antes."
          }
        }
      }
    },
    "welcome.paste.textWithoutShortcut": {
      "comment": "Welcome content: text of the history note on pasting, when no activation shortcut is set.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you copy is kept here, newest first.\n\nOpen Pasto from its icon in the menu bar, choose an item with the arrow keys and press Return to paste it. Press Space for a closer look first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que copias se guarda aquí, lo más reciente primero.\n\nAbre Pasto desde su icono en la barra de menús, elige un ítem con las flechas y pulsa Retorno para pegarlo. Pulsa Espacio para verlo de cerca antes."
          }
        }
      }
    },
    "welcome.paste.title": {
      "comment": "Welcome content: name of the history note on pasting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste Again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega de nuevo"
          }
        }
      }
    },
    "welcome.pin.text": {
      "comment": "Welcome content: text of the history note on pinboards.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click an item and choose Pin to keep it on a pinboard, or drag it onto a pinboard’s tab.\n\nPinned items stay put when older copies leave the history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en un ítem y elige Fijar para guardarlo en un pinboard, o arrástralo a la pestaña de un pinboard.\n\nLos ítems fijados se quedan aunque las copias antiguas salgan del historial."
          }
        }
      }
    },
    "welcome.pin.title": {
      "comment": "Welcome content: name of the history note on pinboards.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep What Matters"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lo importante"
          }
        }
      }
    },
    "welcome.pinboard.name": {
      "comment": "Welcome content: name of the pinboard that holds the welcome note and links.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto Links"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaces de Pasto"
          }
        }
      }
    },
    "welcome.releases.pageTitle": {
      "comment": "Welcome content: what the news link's preview says about the release notes page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the notes of every version"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las notas de cada versión"
          }
        }
      }
    },
    "welcome.releases.title": {
      "comment": "Welcome content: name of the link to the release notes, on the welcome pinboard.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What’s New"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Novedades"
          }
        }
      }
    },
    "welcome.search.text": {
      "comment": "Welcome content: text of the history note on searching.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Pasto open, just start typing to search everything you’ve copied.\n\nChoose one of the suggestions that appear as you type to see only what came from one app, or only links, images or files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Pasto abierto, empieza a escribir para buscar en todo lo que has copiado.\n\nElige una de las sugerencias que aparecen al escribir para ver solo lo que vino de una app, o solo enlaces, imágenes o archivos."
          }
        }
      }
    },
    "welcome.search.title": {
      "comment": "Welcome content: name of the history note on searching.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find It Fast"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuéntralo rápido"
          }
        }
      }
    },
    "welcome.website.pageTitle": {
      "comment": "Welcome content: what the website link's preview says about Pasto's home page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See everything Pasto can do"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre todo lo que puede hacer Pasto"
          }
        }
      }
    },
    "welcome.website.title": {
      "comment": "Welcome content: name of the link to Pasto's website, on the welcome pinboard.",
