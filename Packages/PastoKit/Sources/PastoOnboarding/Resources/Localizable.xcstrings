    "setup.shortcut.bothTakenNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other apps already use %1$@ and %2$@. Choose a shortcut here to open Pasto."
