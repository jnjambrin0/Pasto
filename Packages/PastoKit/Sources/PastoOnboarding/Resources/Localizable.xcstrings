    "suggestions.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Suggestions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencias inteligentes"
          }
        }
      }
    },
    "suggestions.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you open Pasto, it can put first the items that suit the app you’re pasting into. It all happens on this Mac, with Apple Intelligence: Pasto looks at that window for a moment and keeps nothing of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir Pasto, puede poner primero los ítems que encajan con la app en la que vas a pegar. Todo ocurre en este Mac, con Apple Intelligence: Pasto mira esa ventana un momento y no guarda nada de ella."
          }
        }
      }
    },
    "suggestions.switch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest items as I paste"
