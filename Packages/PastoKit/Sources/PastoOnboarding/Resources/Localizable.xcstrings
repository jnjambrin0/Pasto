    "notice.openAtLogin.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Pasto with your Mac so nothing you copy is missed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranca Pasto con tu Mac para no perder nada de lo que copies."
          }
        }
      }
    },
    "notice.openAtLogin.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir al iniciar sesión"
          }
        }
      }
    },
    "notice.otherClipboardManagers.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also running: %@. When two apps share a shortcut, only one of them responds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También en marcha: %@. Si dos apps comparten un atajo, solo responde una."
          }
        }
      }
    },
    "notice.otherClipboardManagers.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Clipboard App"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app de portapapeles"
          }
        }
      }
    },
    "notice.pasteboardAccess.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing you copy is saved until you allow it."
