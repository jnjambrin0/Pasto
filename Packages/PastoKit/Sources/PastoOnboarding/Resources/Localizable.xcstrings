    "setup.history.unlimitedWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A history without a limit can take up a lot of disk space over time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un historial sin límite puede ocupar mucho espacio en disco con el tiempo."
          }
        }
      }
    },
    "setup.openAtLogin.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto starts with your Mac and stays out of the way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto arranca con tu Mac y se queda en segundo plano."
          }
        }
      }
    },
    "setup.openAtLogin.title": {
      "extractionState": "manual",
      "localizations": {
