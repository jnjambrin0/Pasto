    "setup.shortcut.conflict.menu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s already the shortcut for the menu command “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
