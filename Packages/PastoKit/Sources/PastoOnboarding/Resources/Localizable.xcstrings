    "alert.reduceHistory.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned items and pinboards are kept. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems fijados y los pinboards se conservan. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "alert.reduceHistory.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some items are older than the new limit. Delete them and apply the limit?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay ítems más antiguos que el nuevo límite. ¿Eliminarlos y aplicar el límite?"
          }
        }
      }
    },
    "intro.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar"
          }
        }
      }
    },
    "intro.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto remembers the text, links, images and files you copy, so you can find any of them later and paste it wherever you are working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto recuerda los textos, enlaces, imágenes y archivos que copias para que puedas encontrarlos más tarde y pegarlos donde estés trabajando."
          }
        }
      }
    },
    "intro.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything You Copy, Ready to Paste Again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que copias, listo para volver a pegarlo"
          }
        }
      }
    },
