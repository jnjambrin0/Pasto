    "notice.shortcutsTaken.description": {
      "comment": "Body of the notice card about shortcuts in use; %@ is the list of shortcuts, such as ⇧⌘V and ⇧⌘C.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
