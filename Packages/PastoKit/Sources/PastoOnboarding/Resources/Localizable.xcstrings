    "notice.storeWriteFailure.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac may be out of space. Pasto keeps trying and this card goes away once it can save again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que el Mac se haya quedado sin espacio. Pasto lo sigue intentando y esta tarjeta se va cuando vuelve a poder guardar."
          }
        }
      }
    },
