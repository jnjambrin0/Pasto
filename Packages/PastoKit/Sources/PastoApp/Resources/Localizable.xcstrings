            "value": "Don’t Move"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No mover"
          }
        }
      }
    },
    "relocation.failure.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ You can drag Pasto to the Applications folder in Finder and open it again from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Puedes arrastrar Pasto a la carpeta Aplicaciones en el Finder y volver a abrirlo desde ahí."
          }
        }
      }
    },
    "relocation.failure.stillRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other copy of Pasto didn’t quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra copia de Pasto no se ha cerrado."
          }
        }
      }
    },
    "relocation.failure.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto couldn’t be moved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido mover Pasto"
          }
        }
      }
    },
    "relocation.message.ephemeral": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto is running from a disk image or from where it was downloaded. From there it can’t update itself or open when you log in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto se está ejecutando desde una imagen de disco o desde donde se descargó. Desde ahí no puede actualizarse ni abrirse al iniciar sesión."
          }
        }
      }
    },
    "relocation.message.outside": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto works best in the Applications folder, where it can update itself and open when you log in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto funciona mejor en la carpeta Aplicaciones, donde puede actualizarse y abrirse al iniciar sesión."
          }
        }
      }
    },
    "relocation.move": {
      "extractionState": "manual",
      "localizations": {
