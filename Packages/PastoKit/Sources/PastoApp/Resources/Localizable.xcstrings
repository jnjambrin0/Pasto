        }
      }
    },
    "report.message": {
      "comment": "Body of the alert that starts a problem report.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write what happened, what you expected and, if you can, how to make it happen again. The versions of Pasto and macOS are filled in for you. Nothing is sent until you send it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe qué ha pasado, qué esperabas y, si puedes, cómo hacer que vuelva a pasar. Las versiones de Pasto y de macOS se rellenan solas. No se envía nada hasta que lo envíes tú."
          }
        }
      }
    },
    "report.email": {
      "comment": "Button: opens a new email to Pasto's support with the versions filled in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write Email"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir correo"
          }
        }
      }
    },
    "report.contactPage": {
      "comment": "Button: opens the contact page of Pasto's website with the versions filled in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Contact Page"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir página de contacto"
          }
        }
      }
    },
    "report.showFiles": {
      "comment": "Checkbox of the problem report alert: shows the crash reports and the log of this session in Finder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Pasto’s diagnostic files in Finder, to attach them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar en Finder los archivos de diagnóstico de Pasto, para adjuntarlos"
          }
        }
      }
    },
    "report.subject": {
      "comment": "Subject of the email of a problem report.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto: a problem"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto: un problema"
          }
        }
      }
    },
    "report.prompt": {
      "comment": "First line of the email of a problem report, for the user to write under.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happened? What did you expect? How can it be made to happen again?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué ha pasado? ¿Qué esperabas? ¿Cómo se puede hacer que vuelva a pasar?"
          }
        }
      }
