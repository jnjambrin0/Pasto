    "statusItem.pasteboardAccessMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto can’t see what you copy. Open the panel to allow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto no ve lo que copias. Abre el panel para permitirlo."
          }
        }
      }
    },
    "alert.storeFailure.migration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database could not be updated for this version of Pasto. It has been left exactly as it was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido actualizar la base de datos para esta versión de Pasto. Se ha dejado exactamente como estaba."
          }
        }
      }
    },
    "alert.storeFailure.newerVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database was created by a newer version of Pasto. Update Pasto to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos se creó con una versión más reciente de Pasto. Actualiza Pasto para abrirla."
          }
        }
      }
    },
    "alert.storeFailure.showInFinder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar en el Finder"
          }
        }
      }
    },
    "alert.storeFailure.startFresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Aside and Start Fresh"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apartar y empezar de cero"
          }
        }
      }
    },
    "alert.storeFailure.tryAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        }
      }
    },
    "alert.storeFailure.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database is damaged or can’t be read. Pasto can set it aside and start with an empty history; nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos está dañada o no se puede leer. Pasto puede apartarla y empezar con un historial vacío; no se borra nada."
          }
        }
      }
    },
