    "relocation.replace.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To put this one in its place, that copy will quit and go to the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poner esta en su lugar, esa copia se cerrará e irá a la Papelera."
          }
        }
      }
    },
    "relocation.replace.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of Pasto in Applications is open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una copia de Pasto abierta en Aplicaciones"
          }
        }
      }
