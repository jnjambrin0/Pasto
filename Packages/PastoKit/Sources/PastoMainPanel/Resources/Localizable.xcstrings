    "guide.suggestions.firstUse": {
      "comment": "Shown once, the first time suggestions are turned on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What suits the app you are pasting into comes first. Choose a tab to go back to your history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero va lo que encaja con la app en la que vas a pegar. Elige una pestaña para volver al historial."
          }
        }
      }
    },
    "guide.suggestions.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
