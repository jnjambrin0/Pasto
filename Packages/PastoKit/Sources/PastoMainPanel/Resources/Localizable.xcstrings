    "picks.access.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto looks at the window you’re about to paste into, here on your Mac, to pick the clips that fit it. Nothing is saved or sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto mira, aquí en tu Mac, la ventana en la que vas a pegar para elegir los ítems que le encajan. No se guarda ni se envía nada."
          }
        }
      }
    },
    "picks.access.title": {
