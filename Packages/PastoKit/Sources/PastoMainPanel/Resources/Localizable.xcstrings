    "guide.cards.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return pastes the selected item and Space previews it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retorno pega el ítem seleccionado y Espacio lo previsualiza."
          }
        }
      }
    },
    "guide.cards.quickPaste": {
      "comment": "%@ is the quick paste keys, such as ⌘1–9.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ paste one of the first nine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pegan uno de los nueve primeros."
          }
        }
      }
    },
    "guide.cards.title": {
      "comment": "Title of the guide's label beside the first card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything You Copy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que copias"
          }
        }
      }
    },
    "guide.more.activation": {
      "comment": "%@ is the activation shortcut, such as ⇧⌘V.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this panel anytime with %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre este panel cuando quieras con %@."
          }
        }
      }
    },
    "guide.more.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings, pausing and help are in this menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes, la pausa y la ayuda están en este menú."
          }
        }
      }
    },
    "guide.more.stack": {
      "comment": "%@ is the Paste Stack shortcut, such as ⇧⌘C.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens the Paste Stack: copy several things, then paste them in order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre el Paste Stack: copia varias cosas y luego pégalas en orden."
          }
        }
      }
    },
    "guide.more.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings and Help"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes y ayuda"
          }
        }
      }
    },
    "guide.pinboards.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboards keep items for good. + makes a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pinboards guardan ítems para siempre. + crea uno nuevo."
          }
        }
      }
    },
    "guide.pinboards.navigation": {
      "comment": "The previous and next tab shortcuts, such as ⌘← and ⌘→.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %@ switch tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %@ cambian de pestaña."
          }
        }
      }
    },
    "guide.pinboards.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboards"
          }
        }
      }
    },
    "guide.search.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just start typing, or press ⌘F, to search everything you have copied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a escribir, o pulsa ⌘F, para buscar en todo lo que has copiado."
          }
        }
      }
    },
    "guide.search.title": {
      "extractionState": "manual",
      "localizations": {
