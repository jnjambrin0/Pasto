{
  "sourceLanguage": "en",
  "strings": {
    "alert.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "alert.deleteItems.title": {
      "comment": "Asked before deleting two or more items.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %lld items?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %lld ítems?"
          }
        }
      }
    },
    "alert.deletePinboard.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items that are only on it are deleted too; the ones in your clipboard history stay there. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminan los ítems que solo están en él; los que están en el historial se conservan. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "alert.deletePinboard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the pinboard “%@”?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el pinboard «%@»?"
          }
        }
      }
    },
    "alert.eraseHistory.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar"
          }
        }
      }
    },
    "alert.eraseHistory.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned items and pinboards are kept. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems fijados y los pinboards se conservan. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "alert.eraseHistory.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase your clipboard history?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar el historial del portapapeles?"
          }
        }
      }
    },
