    "privacy.removeAll": {
      "comment": "Settings › Privacy: row that removes everything Pasto keeps on the Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar todos los datos"
          }
        }
      }
    },
    "privacy.removeAll.info": {
      "comment": "Settings › Privacy: what removing all data takes away.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history, pinboards, what suggestions learnt, the search index and every setting. Pasto quits afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial, los pinboards, lo que han aprendido las sugerencias, el índice de búsqueda y todos los ajustes. Después Pasto se cierra."
          }
        }
      }
    },
    "privacy.removeAll.button": {
      "comment": "Settings › Privacy: button that asks to remove all data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar…"
          }
        }
      }
    },
    "alert.removeAll.title": {
      "comment": "Title of the alert that confirms removing all data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all of Pasto’s data and quit?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todos los datos de Pasto y salir?"
          }
        }
      }
    },
    "alert.removeAll.message": {
      "comment": "Body of the alert that confirms removing all data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasto’s folders go to the Trash, so the history can be recovered until you empty it. Settings and the search index are erased. The permissions you granted stay in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas de Pasto van a la Papelera, así que el historial se puede recuperar hasta que la vacíes. Los ajustes y el índice de búsqueda se borran. Los permisos que concediste siguen en Ajustes del Sistema."
          }
        }
      }
    },
    "alert.removeAll.confirm": {
      "comment": "Button that removes all data and quits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove and Quit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar y salir"
          }
        }
      }
    }
