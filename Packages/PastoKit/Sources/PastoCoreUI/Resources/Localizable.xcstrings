{
  "sourceLanguage" : "en",
  "strings" : {
    "card.accessibility.application" : {
      "comment" : "VoiceOver label of a card that shows no date (on a pinboard): its title and the app it was copied from.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, from %2$@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, de %2$@" } }
      }
    },
    "card.accessibility.content" : {
      "comment" : "VoiceOver label of a card: what is said about it, then the start of its content.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@: %2$@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%1$@: %2$@" } }
      }
    },
    "card.accessibility.date" : {
      "comment" : "VoiceOver label of a card with no source app: its title and how long ago it was copied (\"5 minutes ago\").",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, copied %2$@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, %2$@" } }
      }
    },
    "card.accessibility.dateAndApplication" : {
      "comment" : "VoiceOver label of a card: its title, how long ago it was copied (\"5 minutes ago\") and the app it was copied from.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, copied %2$@ from %3$@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, de %3$@, %2$@" } }
      }
    },
    "card.date.justNow" : {
      "comment" : "Date of an item copied a moment ago, in a card's header.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "just now" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "ahora mismo" } }
      }
    },
